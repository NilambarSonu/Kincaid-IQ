# ─────────────────────────────────────────────────────────────────────────────
# Kincaid IQ — environment variables (copy to .env locally, or set as secrets on
# your host). On AWS, store the sensitive values in AWS Secrets Manager / SSM and
# inject them as the container's environment.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime mode ─────────────────────────────────────────────────────────────
# On Replit this is auto-detected (REPLIT_DEPLOYMENT). OFF Replit you MUST set
# APP_ENV=production, or the app runs in dev mode (open CORS, non-secure cookies).
APP_ENV=production

# Public URL of the deployment. Drives secure-cookie behavior, CORS, e-mail
# digest links, and the export verifier QR codes. Required in production.
APP_BASE_URL=https://app.your-domain.com

# Optional explicit CORS allow-list (comma-separated). When set it overrides the
# auto-derived origins — recommended for a locked-down production setup.
# CORS_ORIGINS=https://app.your-domain.com,https://admin.your-domain.com

# Port the server binds to. App Runner / ECS usually inject this automatically.
PORT=5000

# ── Security (REQUIRED in production) ─────────────────────────────────────────
# Long random string used to sign sessions/JWTs. The app refuses to boot in
# production with the insecure default.
SESSION_SECRET=

# ── Databases ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (point at RDS on AWS).
DATABASE_URL=postgresql://user:password@host:5432/kincaid

# DuckDB analytics file (~186 MB). If absent locally and DUCKDB_REMOTE_URL is
# set, it is downloaded on boot — host it on S3/R2 for AWS.
# DUCKDB_PATH=/app/data/dol5500.duckdb
# Two supported forms:
#   1. Private S3 via the task/instance IAM role (recommended on AWS — nothing
#      expires). Needs s3:GetObject on the object and AWS_REGION set.
#      DUCKDB_REMOTE_URL=s3://your-bucket/dol5500.duckdb
#   2. Any HTTPS URL, including a presigned S3 URL or public object.
#      DUCKDB_REMOTE_URL=https://your-bucket.s3.amazonaws.com/dol5500.duckdb
# AWS_REGION=us-east-1

# ── AI providers ─────────────────────────────────────────────────────────────
# On Replit these come from the AI Integrations gateway (AI_INTEGRATIONS_*).
# OFF Replit, supply direct vendor keys here. Leave the *_BASE_URL unset to hit
# the vendor's public endpoint directly.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# GOOGLE_API_KEY=                 # accepted as an alias for GEMINI_API_KEY
# OPENAI_BASE_URL=
# ANTHROPIC_BASE_URL=

# ── Payments (Stripe) ────────────────────────────────────────────────────────
# Direct keys are used first; the Replit connector is only a fallback on Replit.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

# ── CRM ──────────────────────────────────────────────────────────────────────
# HubSpot private-app token (used directly off Replit). Without it, HubSpot falls
# back to the Replit connector (Replit only) or demo receipts.
HUBSPOT_ACCESS_TOKEN=
# Lightfield (primary CRM)
# LIGHTFIELD_API_KEY=
# LIGHTFIELD_API_VERSION=2026-03-01
# Salesforce (optional)
# SALESFORCE_USERNAME=
# SALESFORCE_PASSWORD=
# SALESFORCE_SECURITY_TOKEN=
# SALESFORCE_DOMAIN=login

# ── OAuth (optional; re-register redirect URIs for your AWS domain) ───────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ── Data-enrichment vendor keys (features degrade gracefully if unset) ────────
# APOLLO_API_KEY=
# CRUNCHBASE_API_KEY=
# HUNTER_API_KEY=
# SAM_GOV_API_KEY=
# THEIRSTACK_API_KEY=
# FRED_API_KEY=

# ── Telephony (optional, Twilio) ─────────────────────────────────────────────
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# ── RFP opportunity scoring (optional tuning) ────────────────────────────────
# Inline JSON override of the scoring model. PREFER this on hosts with no
# persistent disk (e.g. App Runner), since the admin-saved override file in
# data/ is wiped on container restart.
# RFP_SCORING_CONFIG={"weights": {"revenue_potential": 0.25}}
# RFP_SCORING_CONFIG_FILE=/app/data/rfp_scoring_override.json
# RFP_RECALIBRATE_THRESHOLD=10
