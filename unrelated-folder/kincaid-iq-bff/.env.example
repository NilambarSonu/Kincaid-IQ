# Kincaid IQ BFF environment. Keep real secrets in Replit Secrets, never in this file.
# Dedicated port var. We do not use PORT because the host may pin it to another service.
KINCAID_BFF_PORT=8787

# DEMO_OPEN_AUTH is demo only (any value except 0 enables it). Set it to 0 for any
# shared or production deployment and wire the 8 role RBAC sign in instead.
DEMO_OPEN_AUTH=1

# The seed writes this file. node-sqlite3-wasm persists deterministic demo data here.
DB_PATH=kincaid-demo.db
